generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  JEFE_GRUPO
}

enum AcademicUnit {
  UACBI
  UAE
}

enum AcademicProgram {
  INGENIERIA_MECANICA
  INGENIERIA_CONTROL_COMPUTACION
  LICENCIATURA_MATEMATICAS
  INGENIERIA_QUIMICA
  INGENIERIA_ELECTRONICA
  LICENCIATURA_ENFERMERIA
}

enum TeamStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EventType {
  DEPORTIVA
  CULTURAL
  RECREATIVA
  ACADEMICA
  VIDEOJUEGO
  OTRA
}

enum EventStatus {
  BORRADOR
  ABIERTA
  CERRADA
  FINALIZADA
}

enum RegistrationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ScoreCategory {
  TOPACIO
  DIAMANTE
  ESMERALDA
}

enum ScorePosition {
  PRIMER_LUGAR
  SEGUNDO_LUGAR
  TERCER_LUGAR
  PARTICIPACION
  PENALIZACION
}

enum ScoreMovementType {
  SUMA
  RESTA
}

enum TicketEventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum TicketOrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DigitalTicketStatus {
  VALID
  USED
  CANCELLED
}

enum TicketPaymentProvider {
  MERCADOPAGO
  SIMULATED
}

enum TicketScanResult {
  VALID
  USED
  CANCELLED
  INVALID
  NOT_FOUND
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  role      UserRole @default(STAFF)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assignedTeams Team[] @relation("TeamLeader")

  createdScoreLogs ScoreLog[] @relation("ScoreLogCreatedBy")
  createdAuditLogs AuditLog[] @relation("AuditLogCreatedBy")
}

model CulturalEdition {
  id         String   @id @default(cuid())
  name       String
  year       Int
  startDate  DateTime
  endDate    DateTime
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  teams      Team[]
  events     Event[]
  scoreRules ScoreRule[]
  scoreLogs  ScoreLog[]

  @@unique([year])
}

model Team {
  id                  String     @id @default(cuid())
  editionId           String
  unidadAcademica     String // Legacy compatibility: mirrors responsableAcademicUnit when available
  name                String // Internal compatibility: always mirrors animal
  animal              String
  responsableNombre   String
  responsableTelefono String
  responsableCorreo   String
  responsableMatricula String?
  responsableGradoGrupo String?
  responsableAcademicUnit AcademicUnit?
  responsableAcademicProgram AcademicProgram?
  status              TeamStatus @default(PENDIENTE)
  totalPoints         Int        @default(0)
  leaderId            String?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  edition       CulturalEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  members       Member[]
  registrations EventRegistration[]
  scoreLogs     ScoreLog[]
  leader        User? @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@unique([editionId, name])
  @@unique([editionId, animal])
  @@unique([editionId, leaderId])
  @@unique([editionId, responsableCorreo])
}

model Member {
  id                 String   @id @default(cuid())
  teamId             String
  fullName           String
  matricula          String
  institutionalEmail String
  academicUnit       AcademicUnit
  academicProgram    AcademicProgram
  isLeader           Boolean @default(false)
  editionMatriculaKey String @unique
  editionEmailKey     String @unique
  gradoGrupo         String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@index([teamId])
  @@unique([teamId, matricula])
}

model Event {
  id             String        @id @default(cuid())
  editionId      String
  name           String
  slug           String
  type           EventType
  isScored       Boolean       @default(true)
  scoreCategory  ScoreCategory?
  place          String
  eventDate      DateTime
  startTime      DateTime?
  endTime        DateTime?
  description    String?
  teamCapacity   Int?
  memberCapacity Int?
  isVisible      Boolean       @default(true)
  status         EventStatus   @default(BORRADOR)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  edition       CulturalEdition    @relation(fields: [editionId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]
  scoreLogs     ScoreLog[]

  @@index([editionId])
  @@unique([editionId, slug])
}

model EventRegistration {
  id        String             @id @default(cuid())
  eventId   String
  teamId    String
  memberId  String?
  status    RegistrationStatus @default(PENDIENTE)
  checkedIn Boolean            @default(false)
  notes     String?
  teamRegistrationKey   String? @unique
  memberRegistrationKey String? @unique
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([teamId])
  @@index([memberId])
}

model ScoreRule {
  id        String         @id @default(cuid())
  editionId String
  category  ScoreCategory
  position  ScorePosition
  points    Int
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  edition CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, category, position])
}

model ScoreLog {
  id           String            @id @default(cuid())
  editionId    String
  eventId      String?
  teamId       String
  position     ScorePosition?
  movementType ScoreMovementType
  points       Int
  reason       String
  eventPositionKey String? @unique
  createdById  String?
  createdAt    DateTime          @default(now())

  edition   CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  event     Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ScoreLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([teamId])
  @@index([eventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdById String?
  createdAt  DateTime @default(now())

  createdBy User? @relation("AuditLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
}

model TicketEvent {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  eventDate   DateTime
  location    String
  imageUrl    String?
  status      TicketEventStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ticketTypes    TicketType[]
  orders         TicketOrder[]
  digitalTickets DigitalTicket[]

  @@index([status, eventDate])
}

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  soldCount   Int      @default(0)
  maxPerOrder Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event          TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItems     TicketOrderItem[]
  digitalTickets DigitalTicket[]

  @@index([eventId, isActive])
  @@unique([eventId, name])
}

model TicketOrder {
  id                String                @id @default(cuid())
  publicToken       String                @unique
  eventId           String
  buyerName         String
  buyerEmail        String
  buyerPhone        String
  totalAmount       Decimal               @db.Decimal(10, 2)
  status            TicketOrderStatus     @default(PENDING)
  paymentProvider   TicketPaymentProvider @default(SIMULATED)
  providerPaymentId String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  event          TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items          TicketOrderItem[]
  digitalTickets DigitalTicket[]

  @@index([eventId, status])
  @@index([buyerEmail])
}

model TicketOrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([ticketTypeId])
  @@unique([orderId, ticketTypeId])
}

model DigitalTicket {
  id           String            @id @default(cuid())
  orderId      String
  eventId      String
  ticketTypeId String
  folio        String            @unique
  qrToken      String            @unique
  status       DigitalTicketStatus @default(VALID)
  usedAt       DateTime?
  createdAt    DateTime          @default(now())

  order      TicketOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      TicketEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  scanLogs   TicketScanLog[]

  @@index([eventId, status])
  @@index([orderId])
}

model TicketScanLog {
  id          String           @id @default(cuid())
  ticketId    String
  scannedById String?
  result      TicketScanResult
  detail      String?
  createdAt   DateTime         @default(now())

  ticket DigitalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([scannedById])
}

model TicketAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMIN
  STAFF
  JEFE_GRUPO
}

enum OrgRole {
  ADMIN
  STAFF
}

enum TeamStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum RegistrationFeeMode {
  FREE
  FIXED
}

enum TeamPaymentStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
}

enum OrganizationSubscriptionStatus {
  ACTIVE
  SUSPENDED
}

enum EventType {
  DEPORTIVA
  CULTURAL
  RECREATIVA
  ACADEMICA
  VIDEOJUEGO
  OTRA
}

enum EventStatus {
  BORRADOR
  ABIERTA
  CERRADA
  FINALIZADA
}

enum RegistrationStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum ScorePosition {
  PRIMER_LUGAR
  SEGUNDO_LUGAR
  TERCER_LUGAR
  PARTICIPACION
  PENALIZACION
}

enum ScoreMovementType {
  SUMA
  RESTA
}

enum TicketEventStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum TicketOrderStatus {
  PENDING
  PAID
  CANCELLED
  EXPIRED
  REFUNDED
}

enum DigitalTicketStatus {
  VALID
  USED
  CANCELLED
}

enum TicketPaymentProvider {
  MERCADOPAGO
  SIMULATED
}

enum TicketScanResult {
  VALID
  USED
  CANCELLED
  INVALID
  NOT_FOUND
}

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique
  role          UserRole @default(STAFF)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignedTeams Team[]   @relation("TeamLeader")

  createdScoreLogs ScoreLog[]               @relation("ScoreLogCreatedBy")
  createdAuditLogs AuditLog[]               @relation("AuditLogCreatedBy")
  orgMemberships   OrganizationMembership[]
}

// Unidad academica (u otra entidad) que opera su propia Semana Cultural de forma
// independiente. El rol de plataforma (User.role = ADMIN) sigue gobernando modulos
// globales (ej. Delta Tickets); el acceso a una organizacion especifica vive aqui.
model Organization {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Suscripción de plataforma (Fase D1): el dueño de Delta activa/suspende el acceso
  // de esta organización y le asigna un precio. El cobro sigue siendo manual/fuera de
  // banda por ahora — es dinero de la plataforma, no se relaciona con
  // OrganizationMercadoPagoAccount (que es la cuenta propia de la organización para
  // cobrar cuotas de inscripción de equipos).
  subscriptionStatus      OrganizationSubscriptionStatus @default(ACTIVE)
  subscriptionPriceAmount Decimal?                       @db.Decimal(10, 2)
  subscriptionNotes       String?

  editions           CulturalEdition[]
  memberships        OrganizationMembership[]
  mercadoPagoAccount OrganizationMercadoPagoAccount?
}

model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String
  organizationId String
  role           OrgRole
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId])
}

// Cuenta de Mercado Pago que la organizacion conecto via OAuth (flujo "marketplace").
// El dinero de las cuotas de inscripcion de equipos le llega directo a esta cuenta,
// nunca a la de la plataforma. Los tokens se guardan cifrados (ver lib/crypto.ts) —
// nunca en texto plano.
model OrganizationMercadoPagoAccount {
  id                String   @id @default(cuid())
  organizationId    String   @unique
  mercadoPagoUserId String
  accessTokenEnc    String
  refreshTokenEnc   String
  tokenExpiresAt    DateTime
  scope             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CulturalEdition {
  id             String   @id @default(cuid())
  organizationId String
  slug           String
  name           String
  year           Int
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Tema visual de esta edicion (cada edicion puede verse distinta: cambia de tema cada anio).
  themeName      String? // texto corto del badge, ej. "Carnaval Brasileno"
  subtitle       String? // subtitulo debajo del titulo del header
  bannerImageUrl String? // imagen de fondo del hero; si es null se usa un degradado generico de marca
  eventLogoUrl   String? // logo principal/grande de la edicion (el "logo de la semana cultural")
  partnerLogos   Json? // arreglo [{ url, alt }] con el/los logo(s) de unidad academica participante

  // Unidad(es) academica(s) de la UAN que organizan esta edicion, por codigo del
  // catalogo global (ver lib/academic-catalog.ts). Se declara desde la creacion de
  // la edicion; puede ser mas de una si varias unidades se unen para organizarla.
  organizingUnitCodes String[] @default([])

  // Cuota de inscripcion de equipos para esta edicion. FIXED requiere que la
  // organizacion tenga conectada su propia cuenta de Mercado Pago (ver
  // OrganizationMercadoPagoAccount) — el dinero le llega directo a ella, nunca
  // a la cuenta de la plataforma.
  registrationFeeMode   RegistrationFeeMode @default(FREE)
  registrationFeeAmount Decimal?            @db.Decimal(10, 2)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams        Team[]
  events       Event[]
  scoreRules   ScoreRule[]
  scoreLogs    ScoreLog[]
  auditLogs    AuditLog[]

  teamNameOptions TeamNameOption[]
  scoreCategories ScoreCategoryDef[]
  teamPayments    TeamPayment[]

  @@unique([organizationId, year])
  @@unique([organizationId, slug])
  @@index([organizationId])
}

// Catalogos configurables por edicion: cada organizador define su propia tematica
// (nombres de equipo, categorias de puntuacion) en vez de depender de listas fijas
// compartidas por toda la plataforma. Las unidades/carreras academicas, en cambio, son
// un catalogo global fijo (ver lib/academic-catalog.ts) porque un mismo integrante puede
// pertenecer a cualquier unidad academica de la UAN sin importar quien organiza la edicion.

model TeamNameOption {
  id        String @id @default(cuid())
  editionId String
  name      String
  order     Int    @default(0)

  edition CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)

  @@unique([editionId, name])
  @@index([editionId])
}

model ScoreCategoryDef {
  id        String  @id @default(cuid())
  editionId String
  code      String
  label     String
  colorHex  String?
  order     Int     @default(0)

  edition    CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  events     Event[]
  scoreRules ScoreRule[]

  @@unique([editionId, code])
  @@index([editionId])
}

model Team {
  id                             String     @id @default(cuid())
  editionId                      String
  name                           String // Internal compatibility: always mirrors animal
  animal                         String
  responsableNombre              String
  responsableTelefono            String
  responsableCorreo              String
  responsableMatricula           String?
  responsableGradoGrupo          String?
  responsableAcademicUnitCode    String? // codigo del catalogo global (lib/academic-catalog.ts)
  responsableAcademicProgramCode String? // codigo del catalogo global (lib/academic-catalog.ts)
  status                         TeamStatus @default(PENDIENTE)
  totalPoints                    Int        @default(0)
  leaderId                       String?
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  edition       CulturalEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  members       Member[]
  registrations EventRegistration[]
  scoreLogs     ScoreLog[]
  payments      TeamPayment[]
  leader        User?               @relation("TeamLeader", fields: [leaderId], references: [id], onDelete: SetNull)

  @@unique([editionId, name])
  @@unique([editionId, animal])
  @@unique([editionId, leaderId])
  @@unique([editionId, responsableCorreo])
  @@index([editionId])
}

model Member {
  id                  String   @id @default(cuid())
  teamId              String
  fullName            String
  matricula           String
  institutionalEmail  String
  academicUnitCode    String // codigo del catalogo global (lib/academic-catalog.ts)
  academicProgramCode String // codigo del catalogo global (lib/academic-catalog.ts)
  isLeader            Boolean  @default(false)
  editionMatriculaKey String   @unique
  editionEmailKey     String   @unique
  gradoGrupo          String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  team          Team                @relation(fields: [teamId], references: [id], onDelete: Cascade)
  registrations EventRegistration[]

  @@unique([teamId, matricula])
  @@index([teamId])
}

// Cuota de inscripcion pagada (o en proceso de pago) por un equipo. El pago se
// procesa contra la cuenta de Mercado Pago de la organizacion (OrganizationMercadoPagoAccount),
// nunca la de la plataforma. Un equipo puede tener varios intentos (PENDING -> PAID,
// o PENDING -> CANCELLED/EXPIRED con un nuevo intento despues).
model TeamPayment {
  id                String            @id @default(cuid())
  editionId         String
  teamId            String
  publicToken       String            @unique // external_reference de Mercado Pago
  amount            Decimal           @db.Decimal(10, 2)
  status            TeamPaymentStatus @default(PENDING)
  providerPaymentId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  edition CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  team    Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([editionId])
  @@index([teamId])
}

model Event {
  id              String      @id @default(cuid())
  editionId       String
  name            String
  slug            String
  type            EventType
  isScored        Boolean     @default(true)
  scoreCategoryId String?
  place           String
  eventDate       DateTime
  startTime       DateTime?
  endTime         DateTime?
  description     String?
  teamCapacity    Int?
  memberCapacity  Int?
  isVisible       Boolean     @default(true)
  status          EventStatus @default(BORRADOR)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  edition       CulturalEdition     @relation(fields: [editionId], references: [id], onDelete: Cascade)
  scoreCategory ScoreCategoryDef?   @relation(fields: [scoreCategoryId], references: [id], onDelete: SetNull)
  registrations EventRegistration[]
  scoreLogs     ScoreLog[]

  @@unique([editionId, slug])
  @@index([editionId])
  @@index([scoreCategoryId])
}

model EventRegistration {
  id                    String             @id @default(cuid())
  eventId               String
  teamId                String
  memberId              String?
  status                RegistrationStatus @default(PENDIENTE)
  checkedIn             Boolean            @default(false)
  notes                 String?
  teamRegistrationKey   String?            @unique
  memberRegistrationKey String?            @unique
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  event  Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team   Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member? @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([teamId])
  @@index([memberId])
}

model ScoreRule {
  id              String        @id @default(cuid())
  editionId       String
  scoreCategoryId String
  position        ScorePosition
  points          Int
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  edition       CulturalEdition  @relation(fields: [editionId], references: [id], onDelete: Cascade)
  scoreCategory ScoreCategoryDef @relation(fields: [scoreCategoryId], references: [id], onDelete: Cascade)

  @@unique([editionId, scoreCategoryId, position])
  @@index([scoreCategoryId])
}

model ScoreLog {
  id               String            @id @default(cuid())
  editionId        String
  eventId          String?
  teamId           String
  position         ScorePosition?
  movementType     ScoreMovementType
  points           Int
  reason           String
  eventPositionKey String?           @unique
  createdById      String?
  createdAt        DateTime          @default(now())

  edition   CulturalEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  event     Event?          @relation(fields: [eventId], references: [id], onDelete: SetNull)
  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User?           @relation("ScoreLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([editionId])
  @@index([teamId])
  @@index([eventId])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String?
  detail      String?
  editionId   String?
  createdById String?
  createdAt   DateTime @default(now())

  createdBy User?            @relation("AuditLogCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  edition   CulturalEdition? @relation(fields: [editionId], references: [id], onDelete: SetNull)

  @@index([editionId])
}

model TicketEvent {
  id          String            @id @default(cuid())
  title       String
  slug        String            @unique
  description String?
  eventDate   DateTime
  location    String
  imageUrl    String?
  status      TicketEventStatus @default(DRAFT)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  ticketTypes    TicketType[]
  orders         TicketOrder[]
  digitalTickets DigitalTicket[]

  @@index([status, eventDate])
}

model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  description String?
  price       Decimal  @db.Decimal(10, 2)
  quantity    Int
  soldCount   Int      @default(0)
  maxPerOrder Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  event          TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  orderItems     TicketOrderItem[]
  digitalTickets DigitalTicket[]

  @@unique([eventId, name])
  @@index([eventId, isActive])
}

model TicketOrder {
  id                String                @id @default(cuid())
  publicToken       String                @unique
  eventId           String
  buyerName         String
  buyerEmail        String
  buyerPhone        String
  totalAmount       Decimal               @db.Decimal(10, 2)
  status            TicketOrderStatus     @default(PENDING)
  paymentProvider   TicketPaymentProvider @default(SIMULATED)
  providerPaymentId String?               @unique
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  event          TicketEvent       @relation(fields: [eventId], references: [id], onDelete: Restrict)
  items          TicketOrderItem[]
  digitalTickets DigitalTicket[]

  @@index([eventId, status])
  @@index([buyerEmail])
}

model TicketOrderItem {
  id           String  @id @default(cuid())
  orderId      String
  ticketTypeId String
  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2)
  subtotal     Decimal @db.Decimal(10, 2)

  order      TicketOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketType TicketType  @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([orderId, ticketTypeId])
  @@index([orderId])
  @@index([ticketTypeId])
}

model DigitalTicket {
  id           String              @id @default(cuid())
  orderId      String
  eventId      String
  ticketTypeId String
  folio        String              @unique
  qrToken      String              @unique
  status       DigitalTicketStatus @default(VALID)
  usedAt       DateTime?
  createdAt    DateTime            @default(now())

  order      TicketOrder     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event      TicketEvent     @relation(fields: [eventId], references: [id], onDelete: Restrict)
  ticketType TicketType      @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)
  scanLogs   TicketScanLog[]

  @@index([eventId, status])
  @@index([orderId])
}

model TicketScanLog {
  id          String           @id @default(cuid())
  ticketId    String
  scannedById String?
  result      TicketScanResult
  detail      String?
  createdAt   DateTime         @default(now())

  ticket DigitalTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId, createdAt])
  @@index([scannedById])
}

model TicketAuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String?
  detail     String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}
